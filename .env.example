# Telegram Bot Configuration
BOT_TOKEN=your-bot-token-from-botfather

# Telegram Bot API Server (optional; only set when self-hosting the API)
# Get these from https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash
# TELEGRAM_BOT_API_URL=http://telegram-bot-api:8081

# Downloader Configuration
RECLIP_URL=http://127.0.0.1:8899
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT=900

# Optional YouTube cookies (HTTPS URL to a Netscape-format cookies.txt file).
# Keep the file private; never commit cookies or paste them into chat.
YOUTUBE_COOKIES_URL=
YOUTUBE_COOKIES_REFRESH_SECONDS=900

# Cleanup Configuration
CLEANUP_MAX_AGE_HOURS=1
CLEANUP_MAX_DISK_MB=5000
CLEANUP_INTERVAL_SECONDS=300

# Shared downloads directory
DOWNLOADS_PATH=/tmp/afrodit-downloads

# Dashboard Configuration (ADMIN_PASSWORD is required by start.py)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
SECRET_KEY=change-me-to-a-long-random-secret
AFRODIT_EVENT_SECRET=

# Telegram custom emoji sticker-set short name (link: t.me/addemoji/<name>)
CUSTOM_EMOJI_PACK=RestrictedEmoji
